<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="SteamBuildIdManager.Views.Dialogs.GameConfigDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="新建 Steam 配置"
    PrimaryButtonText="保存并写入 ACF"
    CloseButtonText="取消"
    DefaultButton="Primary"
    MinWidth="820"
    MaxWidth="920"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <ScrollViewer MaxHeight="620" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Width="740" Spacing="12">

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="AppIdBox" Header="AppID" PlaceholderText="例如 123456"
                         LostFocus="AppIdBox_LostFocus"/>
                <Button x:Name="FetchButton" Grid.Column="1" Content="获取 Steam 信息"
                        VerticalAlignment="Bottom" Click="Fetch_Click"/>
            </Grid>

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="NameBox" Header="显示名称" PlaceholderText="写入 ACF 的游戏名称"/>
                <TextBox x:Name="InstallDirBox" Grid.Column="1" Header="安装目录名"
                         PlaceholderText="steamapps\common 下的目录名"/>
            </Grid>

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="BuildIdBox" Header="BuildID" PlaceholderText="必须是正整数"/>
                <TextBox x:Name="ExeBox" Grid.Column="1" Header="Steam 占位文件名"
                         PlaceholderText="例如 Game.exe"/>
            </Grid>

            <ComboBox x:Name="ExecutableCombo" Header="Steam 启动项候选"
                      PlaceholderText="获取 Steam 信息后可选择"
                      DisplayMemberPath="DisplayText"
                      HorizontalAlignment="Stretch"
                      SelectionChanged="ExecutableCombo_SelectionChanged"
                      Visibility="Collapsed"/>

            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="10">
                <StackPanel Spacing="4">
                    <TextBlock Text="将写入的 Depot" FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock x:Name="DepotsText" Text="点击“获取 Steam 信息”后自动填充。"
                               TextWrapping="Wrap" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <ComboBox x:Name="LibraryCombo" Header="写入的 Steam 库"
                      HorizontalAlignment="Stretch"/>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="RealExeBox" Header="真实游戏 EXE（可选）"
                         PlaceholderText="例如 D:\Games\Game\game.exe"/>
                <Button Grid.Column="1" Content="浏览" VerticalAlignment="Bottom" Click="BrowseRealExe_Click"/>
            </Grid>

            <TextBox x:Name="ArgumentsBox" Header="启动参数（可选）"
                     PlaceholderText="例如 -dx11；无需填写 %command%"/>

            <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="False"/>

            <TextBlock TextWrapping="Wrap" FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                保存后会创建空占位 EXE 并写入 appmanifest_&lt;AppID&gt;.acf。真实游戏 EXE 只用于生成启动命令，
                不会被复制或修改。请把生成的启动命令粘贴到 Steam 游戏的启动选项中。
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>