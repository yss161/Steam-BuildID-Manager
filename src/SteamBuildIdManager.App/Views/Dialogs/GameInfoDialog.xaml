<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="SteamBuildIdManager.Views.Dialogs.GameInfoDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="获取游戏信息"
    PrimaryButtonText="复制启动命令并关闭"
    SecondaryButtonText="创建为新配置"
    CloseButtonText="关闭"
    DefaultButton="Close"
    MinWidth="560">

    <StackPanel Spacing="12">
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="AppIdBox" Header="AppID" PlaceholderText="例如 730"/>
            <Button x:Name="LookupButton" Grid.Column="1" Content="获取信息"
                    VerticalAlignment="Bottom" Click="Lookup_Click"/>
        </Grid>

        <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="False"/>

        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="6" Padding="12">
            <Grid ColumnSpacing="16" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="显示名称" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="NameText" Grid.Column="1" Text="—" TextWrapping="Wrap"/>

                <TextBlock Grid.Row="1" Text="安装目录名" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="InstallDirText" Grid.Row="1" Grid.Column="1" Text="—"
                           FontFamily="Consolas" TextWrapping="Wrap"/>

                <TextBlock Grid.Row="2" Text="BuildID" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="BuildIdText" Grid.Row="2" Grid.Column="1" Text="—" FontFamily="Consolas"/>

                <TextBlock Grid.Row="3" Text="主 DepotID" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="DepotIdText" Grid.Row="3" Grid.Column="1" Text="—" FontFamily="Consolas"/>

                <TextBlock Grid.Row="4" Text="主 Manifest" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="ManifestText" Grid.Row="4" Grid.Column="1" Text="—" FontFamily="Consolas"/>

                <TextBlock Grid.Row="5" Text="启动 EXE" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="ExecutableText" Grid.Row="5" Grid.Column="1" Text="—"
                           FontFamily="Consolas" TextWrapping="Wrap"/>

                <TextBlock Grid.Row="6" Text="Steam 占位文件名" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="PlaceholderText" Grid.Row="6" Grid.Column="1" Text="—"
                           FontFamily="Consolas" TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <StackPanel Spacing="4">
            <TextBlock Text="全部 Depot" FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="DepotsText" Text="尚未获取" FontFamily="Consolas"
                           FontSize="12" TextWrapping="Wrap"/>
            </ScrollViewer>
        </StackPanel>

        <TextBlock Text="信息来自 api.steamcmd.net 的 public 分支；这里只做只读展示，不会修改任何文件。"
                   FontSize="12" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    </StackPanel>
</ContentDialog>
