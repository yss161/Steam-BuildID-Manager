<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SteamBuildIdManager.Views.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <Page.Resources>
        <Style x:Key="StretchListViewItem" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
    </Page.Resources>

    <Grid Padding="28,20,28,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="BuildID 管理" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Text="扫描 Steam 库中的 appmanifest_*.acf，对比公开分支 BuildID，并一键更新占位配置。"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <InfoBar x:Name="PageInfoBar" Grid.Row="1" IsOpen="False" IsClosable="True"/>

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Content="刷新列表" Click="Refresh_Click"/>
            <Button x:Name="CheckButton" Grid.Column="1" Content="检测 BuildID 更新"
                    Style="{StaticResource AccentButtonStyle}" Click="Check_Click"/>
            <Button x:Name="UpdateAllButton" Grid.Column="2" Content="一键更新全部" Click="UpdateAll_Click"/>
            <Button x:Name="AddButton" Grid.Column="3" Content="新建配置" Click="Add_Click"/>
            <Button x:Name="InfoButton" Grid.Column="4" Content="获取游戏信息" Click="GameInfo_Click"
                    ToolTipService.ToolTip="按 AppID 读取显示名称、安装目录名、BuildID、主 DepotID 和主 Manifest"/>
            <Button x:Name="SettingsButton" Grid.Column="5" Content="设置" Click="Settings_Click"/>
            <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ProgressRing x:Name="BusyRing" Width="18" Height="18" IsActive="False"/>
                <TextBlock x:Name="BusyText" FontSize="12" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            <TextBlock x:Name="SummaryText" Grid.Column="7" HorizontalAlignment="Right"
                       VerticalAlignment="Center" FontSize="13"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Grid>

        <Grid Grid.Row="3">
            <ToggleSwitch x:Name="ShowAllToggle"
                          OnContent="显示全部 Steam 游戏"
                          OffContent="仅显示占位配置"
                          Toggled="ShowAll_Toggled"
                          ToolTipService.ToolTip="占位配置的 SizeOnDisk 为 0。关闭时只列出本工具可安全维护的配置。"/>
        </Grid>

        <Border Grid.Row="4"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Padding="16,10" ColumnSpacing="12"
                      Background="{ThemeResource LayerFillColorAltBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.3*"/>
                        <ColumnDefinition Width="0.85*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="游戏" FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock Grid.Column="1" Text="AppID" FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock Grid.Column="2" Text="当前 BuildID" FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock Grid.Column="3" Text="最新 BuildID" FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock Grid.Column="4" Text="状态" FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock Grid.Column="5" Text="操作" FontWeight="SemiBold" FontSize="12" MinWidth="144"/>
                </Grid>

                <ListView x:Name="ManifestList"
                          Grid.Row="1"
                          SelectionMode="None"
                          IsItemClickEnabled="False"
                          ItemContainerStyle="{StaticResource StretchListViewItem}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="16,10" ColumnSpacing="12"
                                  ToolTipService.ToolTip="{Binding ToolTip}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.3*"/>
                                    <ColumnDefinition Width="0.85*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <TextBlock Grid.Column="1" Text="{Binding AppId}"
                                           VerticalAlignment="Center" FontFamily="Consolas"/>
                                <TextBlock Grid.Column="2" Text="{Binding BuildId}"
                                           VerticalAlignment="Center" FontFamily="Consolas"/>
                                <TextBlock Grid.Column="3" Text="{Binding LatestBuildIdDisplay}"
                                           VerticalAlignment="Center" FontFamily="Consolas"/>

                                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6"
                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="{Binding Message}">
                                    <FontIcon Glyph="{Binding StatusGlyph}" FontSize="14"
                                              Foreground="{Binding StatusBrush}"/>
                                    <TextBlock Text="{Binding StatusText}" FontSize="13"
                                               Foreground="{Binding StatusBrush}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6"
                                            VerticalAlignment="Center">
                                    <Button Content="更新" MinWidth="64" Click="UpdateRow_Click"
                                            IsEnabled="{Binding CanUpdate}"/>
                                    <Button Content="重建" MinWidth="64" Click="RebuildRow_Click"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel x:Name="EmptyState" Grid.Row="1" Spacing="12"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <FontIcon Glyph="&#xE8F1;" FontSize="38"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="EmptyStateTitle" Text="没有找到可管理的 Steam 配置"
                               FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="EmptyStateMessage"
                               Text="请确认 Steam 库路径，或点击“新建配置”创建一个占位配置。"
                               TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <Button Content="新建配置" Style="{StaticResource AccentButtonStyle}" Click="Add_Click"/>
                        <Button Content="打开设置" Click="Settings_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="5"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="14">
            <StackPanel Spacing="8">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="运行日志" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LogHintText" Grid.Column="1" FontSize="11"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                        <Button Content="清空" Click="ClearLog_Click" FontSize="12" Padding="10,3"/>
                        <Button Content="打开日志文件" Click="OpenLogFolder_Click" FontSize="12" Padding="10,3"/>
                    </StackPanel>
                </Grid>

                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="6"
                        Background="{ThemeResource LayerFillColorAltBrush}">
                    <ScrollViewer x:Name="LogScroll" Height="130" Padding="10,6"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="LogText" FontFamily="Consolas" FontSize="12"
                                   TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                   Text="暂无日志。"/>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Page>