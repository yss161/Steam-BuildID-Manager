<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SteamBuildIdManager.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="28,20,28,24" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" MaxWidth="980" HorizontalAlignment="Left">

            <StackPanel Spacing="4">
                <TextBlock Text="设置" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="Steam 路径与账户信息只保存在本机，不会上传。"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <InfoBar x:Name="SettingsInfoBar" IsOpen="False" IsClosable="True"/>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="18">
                <StackPanel Spacing="12">
                    <TextBlock Text="Steam 客户端" FontSize="16" FontWeight="SemiBold"/>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="InstallPathBox" Header="Steam 安装路径"
                                 PlaceholderText="例如 C:\Program Files (x86)\Steam"/>
                        <Button Grid.Column="1" Content="自动检测" VerticalAlignment="Bottom"
                                Click="AutoDetectInstall_Click"/>
                        <Button Grid.Column="2" Content="浏览" VerticalAlignment="Bottom"
                                Click="BrowseInstall_Click"/>
                    </Grid>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SteamIdBox" Header="SteamID64"
                                 PlaceholderText="例如 76561198000000000"
                                 ToolTipService.ToolTip="写入 ACF 的 LastOwner。仅新建配置时需要；只更新 BuildID 时可以不填。"/>
                        <Button Grid.Column="1" Content="读取本地账号" VerticalAlignment="Bottom"
                                Click="ReadSteamId_Click"
                                ToolTipService.ToolTip="从 Steam 安装目录下的 config/loginusers.vdf 读取最近登录的账号"/>
                    </Grid>
                    <TextBlock Text="SteamID64 可在 Steam 个人资料页或 steamid.io 查询；也可以点击“读取本地账号”自动填充。只更新 BuildID 时不需要填写。"
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="18">
                <StackPanel Spacing="12">
                    <TextBlock Text="Steam 库文件夹" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="扫描每个库根目录下的 steamapps\appmanifest_*.acf。留空时自动读取 libraryfolders.vdf。"
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="8">
                        <ItemsControl x:Name="LibraryList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="4,4" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Column="1" Content="移除" Click="RemoveLibrary_Click"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="NewLibraryBox" PlaceholderText="手动输入库根目录，例如 D:\SteamLibrary"/>
                        <Button Grid.Column="1" Content="添加" Click="AddLibrary_Click"/>
                        <Button Grid.Column="2" Content="浏览" Click="BrowseLibrary_Click"/>
                        <Button Grid.Column="3" Content="自动检测" Click="AutoDetectLibraries_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="SaveButton" Content="保存设置" Style="{StaticResource AccentButtonStyle}"
                        Click="Save_Click"/>
                <TextBlock x:Name="SaveStatusText" VerticalAlignment="Center" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="18">
                <StackPanel Spacing="12">
                    <TextBlock Text="外观" FontSize="16" FontWeight="SemiBold"/>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="主题" FontSize="14"/>
                            <TextBlock Text="跟随系统时由 Windows 的浅色/深色设置决定。"
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ComboBox x:Name="ThemeCombo" Grid.Column="1" MinWidth="150" VerticalAlignment="Center"
                                  SelectionChanged="ThemeCombo_SelectionChanged">
                            <ComboBoxItem Content="跟随系统" Tag="system"/>
                            <ComboBoxItem Content="浅色" Tag="light"/>
                            <ComboBoxItem Content="深色" Tag="dark"/>
                        </ComboBox>
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="背景图片" FontSize="14"/>
                            <TextBlock x:Name="BackgroundPathText" Text="未设置"
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="选择图片" VerticalAlignment="Center"
                                Click="PickBackground_Click"/>
                        <Button x:Name="ClearBackgroundButton" Grid.Column="2" Content="清除"
                                VerticalAlignment="Center" Click="ClearBackground_Click"/>
                    </Grid>

                    <StackPanel Spacing="4">
                        <TextBlock x:Name="OpacityHeaderText" Text="背景不透明度" FontSize="14"/>
                        <Slider x:Name="BackgroundOpacitySlider" Minimum="10" Maximum="100"
                                StepFrequency="5" TickFrequency="10"
                                ValueChanged="BackgroundOpacity_ValueChanged"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="18">
                <StackPanel Spacing="12">
                    <TextBlock Text="启动方式" FontSize="16" FontWeight="SemiBold"/>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="以管理员身份启动" FontSize="14"/>
                            <TextBlock Text="开启后启动时会请求 UAC 提权，便于写入受保护目录中的 ACF。"
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch x:Name="RunAsAdminToggle" Grid.Column="1" VerticalAlignment="Center"
                                      OnContent="已开启" OffContent="已关闭"
                                      Toggled="RunAsAdmin_Toggled"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7EF;" FontSize="14"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="ElevationStatusText" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Button x:Name="RestartElevatedButton" Content="立即以管理员重启"
                                Click="RestartElevated_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="18">
                <StackPanel Spacing="10">
                    <TextBlock Text="关于" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="AboutVersionText" FontSize="13"/>
                    <TextBlock Text="本工具是 Steam 占位 ACF 与 BuildID 管理工具：不会修改游戏文件，也不会修改内存。"
                               TextWrapping="Wrap" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="本项目基于 SteamCN-GameLauncher 精简而来，仅保留 Steam ACF 配置与 BuildID 相关功能。"
                               TextWrapping="Wrap" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <HyperlinkButton Content="原项目 SteamCN-GameLauncher"
                                         NavigateUri="https://github.com/Clearlove0923/SteamCN-GameLauncher"/>
                        <HyperlinkButton Content="本仓库"
                                         NavigateUri="https://github.com/yss161/Steam-BuildID-Manager"/>
                    </StackPanel>
                    <TextBlock Text="使用本工具修改 ACF 可能不符合 Steam 服务条款，请自行评估风险；开发者不承担由此产生的任何责任。"
                               TextWrapping="Wrap" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>